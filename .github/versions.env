# Pinned versions for every GitHub Actions workflow in this repository.
#
# This file is the only place a toolchain or tool version is written. Both
# `ci.yml` and `release.yml` load it through `.github/actions/load-versions`
# and re-export it as job outputs, so bumping a version here reaches every job
# in both workflows.
#
# Runner labels and the release target matrix are not here. They live in
# `.github/build-targets.json`, because `runs-on:` cannot read a workflow
# `env:` value and needs a job output instead.
#
# Format: one `KEY=value` per line. No quotes, no shell expansion, no trailing
# comment after a value. Blank lines and whole-line `#` comments are skipped.
# `docs/ci.md` documents the same numbers and `tests/supply_chain_ci.rs` fails
# when the two disagree.

# Stable toolchain every Rust job compiles with.
RUST_TOOLCHAIN=1.94.0

# Pinned, not "nightly": a floating nightly caught an upstream codegen ICE
# building tokio under ASan/sancov (rustc bug, not ours). Bump this date
# forward only after confirming the fuzz job is green on the new nightly.
FUZZ_NIGHTLY_TOOLCHAIN=nightly-2026-06-15

CARGO_AUDIT_VERSION=0.22.1
CARGO_DENY_VERSION=0.19.0
CARGO_FUZZ_VERSION=0.13.1
CROSS_VERSION=0.2.5

# Node 22 is used by landing and npm Trusted Publishing.
NODE_VERSION=22
# OIDC publishing requires npm 11.5.1 or newer.
NPM_CLI_VERSION=11.13.0

# Iterations per fuzz target in the fuzz job.
FUZZ_RUNS=100000
FUZZ_MAX_LEN=65536
